@@ -0,0 +1,133 @@
+/**
+ * Shell-owned Updates section: channel choice, update availability, the
+ * apply button, and the carrier-driven progress bar. The presentation
+ * itself (phase, percent, failure) arrives through the shared desktop
+ * update observable owned by desktop-update-source.ts.
+ */
+import { useState } from 'react'
+import type { HostObservable, InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { Button, Menu } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { DesktopUpdateChannel, DesktopUpdatePresentation, DesktopUpdateView } from '../types.ts'
+import type { DesktopUpdateChannelView } from './desktop-update-source.ts'
+import css from './UpdatesSection.module.css'
+
+/** Injected face: the shared update observables plus the carrier controls. */
+export interface UpdatesSectionInjected {
+  hooks: {
+    /** Shared carrier status (phase, percent, failure). */
+    desktopUpdate: HostObservable<DesktopUpdateView>
+    /** Channel choice and apply-button state. */
+    updateChannel: HostObservable<DesktopUpdateChannelView>
+  }
+  /** Whether the carrier offers channel selection (Linux shell only). */
+  hasChannelControl: boolean
+  /** Whether the carrier applies updates itself (Linux shell only). */
+  hasApply: boolean
+  /** Persist a channel choice. */
+  setChannel: (channel: DesktopUpdateChannel) => void
+  /** Start the carrier-owned update flow. */
+  apply: () => void
+}
+
+/** Full component props: section owner share, locale seat, injected face. */
+export type UpdatesSectionComponentProps =
+  PropsRuntime<'settings.section'> & PropsLocale<'settings'> & InjectFace<UpdatesSectionInjected>
+
+/** Phases that render a moving progress bar. */
+const BUSY_PHASES: ReadonlySet<DesktopUpdatePresentation['phase']> = new Set([
+  'checking', 'downloading', 'verifying', 'installing',
+])
+
+/**
+ * Render the Updates section.
+ * @param props - composed slot props (contract/slots.ts).
+ * @returns the section element tree.
+ */
+export function UpdatesSection(props: UpdatesSectionComponentProps) {
+  const { t, useDesktopUpdate, useUpdateChannel, hasChannelControl, hasApply, setChannel, apply } = props
+  const { presentation, failed } = useDesktopUpdate(value => value)
+  const { channel, applying } = useUpdateChannel(value => value)
+  const [menuOpen, setMenuOpen] = useState(false)
+  const busy = applying || (presentation !== undefined && BUSY_PHASES.has(presentation.phase))
+  const available = presentation?.phase === 'available'
+  const version = process.env.DSH_CLIENT_VERSION
+  return (
+    <div className={css.section}>
+      {hasChannelControl && (
+        <div className={css.row}>
+          <div className={css.rowText}>
+            <div className={css.title}>{t('updates.channel')}</div>
+            <div className={css.description}>{t('updates.channel.description')}</div>
+          </div>
+          <Menu
+            open={menuOpen}
+            onClose={() => { setMenuOpen(false) }}
+            items={[
+              { id: 'rc', label: t('updates.channel.rc') },
+              { id: 'beta', label: t('updates.channel.beta') },
+            ]}
+            selectedId={channel}
+            onSelect={(id) => { setChannel(id as DesktopUpdateChannel); setMenuOpen(false) }}
+            align="end"
+            portal
+            anchor={(
+              <button
+                type="button"
+                className={css.selector}
+                aria-haspopup="menu"
+                aria-expanded={menuOpen}
+                onClick={() => { setMenuOpen(v => !v) }}
+              >
+                {channel === 'beta' ? t('updates.channel.beta') : t('updates.channel.rc')}
+              </button>
+            )}
+          />
+        </div>
+      )}
+      <div className={css.row}>
+        <div className={css.rowText}>
+          <div className={css.title}>
+            {version === undefined ? t('updates.title') : t('updates.currentVersion', { version })}
+            {available && <span className={css.badge} role="img" aria-label={t('updates.availableHint')} />}
+          </div>
+          {available && (
+            <div className={css.description}>
+              {t('updates.availableVersion', { version: presentation?.version ?? '' })}
+            </div>
+          )}
+          {failed && <div className={css.error}>{t('updates.error')}</div>}
+          {presentation?.phase === 'error' && <div className={css.error}>{t('updates.errorDetail')}</div>}
+        </div>
+        {hasApply && (
+          <Button
+            className={css.apply}
+            variant={available ? 'primary' : 'outline'}
+            disabled={busy}
+            onClick={apply}
+          >
+            {presentation?.phase === 'ready' ? t('desktop.update.ready') : t('updates.apply')}
+          </Button>
+        )}
+      </div>
+      {busy && presentation !== undefined && (
+        <div className={css.progress}>
+          <div className={css.progressTrack}>
+            <div className={css.progressFill} style={{ width: `${Math.max(2, Math.min(100, presentation.percent ?? 0))}%` }} />
+          </div>
+          <div className={css.progressLabel}>
+            {presentation.phase === 'downloading'
+              ? t('desktop.update.downloadDetail', { percent: presentation.percent ?? 0, version: presentation.version ?? '' })
+              : presentation.phase === 'verifying' ? t('desktop.update.verifying')
+                : presentation.phase === 'installing' ? t('desktop.update.installing')
+                  : t('desktop.update.checking')}
+          </div>
+        </div>
+      )}
+      {!hasApply && (
+        <div className={css.row}>
+          <div className={css.description}>{t('updates.unavailable')}</div>
+        </div>
+      )}
+    </div>
+  )
+}
