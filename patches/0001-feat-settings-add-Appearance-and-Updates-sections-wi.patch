diff --git a/packages/client/ui-settings-general/src/client/AppearanceControlRows.tsx b/packages/client/ui-settings-general/src/client/AppearanceControlRows.tsx
new file mode 100644
index 0000000000..47a23e7a07
--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/AppearanceControlRows.tsx
@@ -0,0 +1,146 @@
+/**
+ * Shell-owned Appearance section rows for the Linux desktop carrier:
+ * corner-radius scale, the user stylesheet, and the status-area app
+ * indicator. Each row reads the shared appearance observable and writes
+ * through the injected callbacks; without a native carrier the same
+ * preferences persist in localStorage (appearance-source.ts).
+ */
+import { useRef, useState } from 'react'
+import type { HostObservable, InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { SegmentedControl, Switch } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { DesktopAppearanceView } from './appearance-source.ts'
+import css from './AppearanceControlRows.module.css'
+
+/** Shared injected face: the appearance observable plus its write callbacks. */
+export interface AppearanceRowsInjected {
+  hooks: {
+    /** Framework-observed appearance state (carrier or browser fallback). */
+    appearance: HostObservable<DesktopAppearanceView>
+  }
+  /** Change the corner-radius scale. */
+  setCornerRadiusScale: (scale: number) => void
+  /** Replace the user stylesheet. */
+  setCustomCss: (css: string) => void
+  /** Show or hide the status-area app indicator. */
+  setAppindicatorEnabled: (enabled: boolean) => void
+  /** Pick the app indicator artwork. */
+  setIconStyle: (style: 'symbolic' | 'coloured') => void
+}
+
+/** Shared component props for all three rows. */
+export type AppearanceRowComponentProps =
+  PropsRuntime<'settings.appearance.item'> & PropsLocale<'settings'> & InjectFace<AppearanceRowsInjected>
+
+const RADIUS_MIN = 0
+const RADIUS_MAX = 2
+const RADIUS_STEP = 0.05
+
+/**
+ * Render the corner-radius row: a 0–200% scale slider over the shared
+ * `--dsw-radius-*` tokens, which every button, input, and card corner reads.
+ * @param props - composed slot props (injected face + locale seat).
+ * @returns the row element tree.
+ */
+export function CornerRadiusRow({ t, useAppearance, setCornerRadiusScale }: AppearanceRowComponentProps) {
+  const scale = useAppearance(s => s.cornerRadiusScale)
+  const percent = Math.round(scale * 100)
+  return (
+    <div className={css.row}>
+      <div className={css.rowText}>
+        <div className={css.title}>{t('appearance.radius.title')}</div>
+        <div className={css.description}>{t('appearance.radius.description')}</div>
+      </div>
+      <div className={css.sliderGroup}>
+        <input
+          type="range"
+          className={css.slider}
+          min={RADIUS_MIN}
+          max={RADIUS_MAX}
+          step={RADIUS_STEP}
+          value={scale}
+          aria-label={t('appearance.radius.title')}
+          onChange={(event) => { setCornerRadiusScale(Number.parseFloat(event.currentTarget.value)) }}
+        />
+        <span className={css.percent} aria-live="polite">{t('appearance.radius.scale', { percent })}</span>
+      </div>
+    </div>
+  )
+}
+
+const CSS_DEBOUNCE_MS = 350
+
+/**
+ * Render the custom-CSS row: a monospace editor whose content the shell
+ * injects as a user stylesheet into every DeepSeek Harness page.
+ * @param props - composed slot props (injected face + locale seat).
+ * @returns the row element tree.
+ */
+export function CustomCssRow({ t, useAppearance, setCustomCss }: AppearanceRowComponentProps) {
+  const saved = useAppearance(s => s.customCss)
+  const [draft, setDraft] = useState(() => saved)
+  const timer = useRef<number | undefined>(undefined)
+  return (
+    <div className={css.row}>
+      <div className={css.rowText}>
+        <div className={css.title}>{t('appearance.customCss.title')}</div>
+        <div className={css.description}>{t('appearance.customCss.description')}</div>
+      </div>
+      <div className={css.cssGroup}>
+        <textarea
+          className={css.editor}
+          value={draft}
+          spellCheck={false}
+          aria-label={t('appearance.customCss.title')}
+          placeholder={t('appearance.customCss.placeholder')}
+          onChange={(event) => {
+            const next = event.currentTarget.value
+            setDraft(next)
+            window.clearTimeout(timer.current)
+            timer.current = window.setTimeout(() => { setCustomCss(next) }, CSS_DEBOUNCE_MS)
+          }}
+        />
+        <button type="button" className={css.reset} onClick={() => { setDraft(''); setCustomCss('') }}>
+          {t('appearance.customCss.reset')}
+        </button>
+      </div>
+    </div>
+  )
+}
+
+/**
+ * Render the app-indicator row: an enable switch and, while enabled, the
+ * symbolic/coloured artwork choice. Hidden without the native carrier.
+ * @param props - composed slot props (injected face + locale seat).
+ * @returns the row element tree, or nothing in ordinary browsers.
+ */
+export function AppindicatorRow({ t, useAppearance, setAppindicatorEnabled, setIconStyle }: AppearanceRowComponentProps) {
+  const state = useAppearance(s => s)
+  if (!state.available) return null
+  return (
+    <div className={css.row}>
+      <div className={css.rowText}>
+        <div className={css.title}>{t('appearance.appindicator.title')}</div>
+        <div className={css.description}>{t('appearance.appindicator.description')}</div>
+      </div>
+      <div className={css.indicatorGroup}>
+        <Switch
+          checked={state.appindicatorEnabled}
+          onChange={setAppindicatorEnabled}
+          label={t('appearance.appindicator.title')}
+        />
+        {state.appindicatorEnabled && (
+          <SegmentedControl
+            id="dsh-appindicator-icon-style"
+            value={state.iconStyle}
+            label={t('appearance.appindicator.iconStyle')}
+            options={[
+              { value: 'coloured', label: t('appearance.appindicator.coloured') },
+              { value: 'symbolic', label: t('appearance.appindicator.symbolic') },
+            ]}
+            onChange={(style) => { setIconStyle(style) }}
+          />
+        )}
+      </div>
+    </div>
+  )
+}
