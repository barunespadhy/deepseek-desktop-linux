+}
+
+/* Corner-radius row: slider + live percent readout. */
+.sliderGroup {
+  flex: none;
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 220px;
+}
+
+.slider {
+  flex: 1;
+  min-width: 120px;
+  margin: 0;
+  accent-color: var(--dsw-alias-brand-primary);
+}
+
+.percent {
+  flex: none;
+  min-width: 40px;
+  text-align: end;
+  font-size: 12px;
+  line-height: 18px;
+  color: var(--dsw-alias-label-secondary);
+}
+
+/* Custom-CSS row: full-width monospace editor under the copy. */
+.cssGroup {
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 8px;
+  width: 100%;
+}
+
+.editor {
+  width: 100%;
+  min-height: 96px;
+  resize: vertical;
+  box-sizing: border-box;
+  padding: 10px 12px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: var(--dsw-radius-md);
+  background: var(--dsw-alias-bg-module-platform);
+  color: var(--dsw-alias-label-primary);
+  font-family: var(--ds-font-family-code);
+  font-size: 12px;
+  line-height: 18px;
+}
+
+.editor:focus {
+  outline: none;
+  border-color: var(--dsw-alias-brand-primary);
+}
+
+.reset {
+  align-self: flex-start;
+  height: 28px;
+  padding: 0 12px;
+  border: 1px solid var(--dsw-alias-border-l2);
+  border-radius: var(--dsw-radius-sm);
+  background: transparent;
