--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/appearance-source.ts
@@ -0,0 +1,157 @@
+/** Client-owned observation and writes of the optional Desktop appearance preload. */
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { DesktopAppearanceBridge, DesktopAppearanceState } from '../types.ts'
+
+/** Appearance state plus whether a native carrier owns it. */
+export interface DesktopAppearanceView extends DesktopAppearanceState {
+  /** Whether the native shell owns these preferences (false = browser fallback). */
+  readonly available: boolean
+}
+
+const DEFAULT_STATE: DesktopAppearanceState = Object.freeze({
+  cornerRadiusScale: 1,
+  customCss: '',
+  appindicatorEnabled: true,
+  iconStyle: 'coloured' as const,
+})
+
+const STORAGE_KEY = 'dsh-linux-appearance'
+const STYLE_ID = 'dsh-linux-appearance-style'
+
+/** Radius token bases the shell scales; matches ui-theme styles/base.css. */
+const RADIUS_BASES: Readonly<Record<string, number>> = Object.freeze({
+  '--dsw-radius-xs': 4,
+  '--dsw-radius-sm': 8,
+  '--dsw-radius-md': 12,
+  '--dsw-radius-lg': 16,
+  '--dsw-radius-xl': 20,
+  '--dsw-radius-panel': 28,
+})
+
+/**
+ * Compose the radius overrides and the user stylesheet into one CSS string.
+ * @param state - current appearance preferences.
+ * @returns the stylesheet the shell injects (native user sheet or fallback style element).
+ */
+export function appearanceCss(state: DesktopAppearanceState): string {
+  const scale = Math.min(2, Math.max(0, state.cornerRadiusScale))
+  const tokens = Object.entries(RADIUS_BASES)
+    .map(([name, base]) => `${name}: ${Math.round(base * scale * 10) / 10}px;`)
+    .join(' ')
+  return `:root { ${tokens} }\n${state.customCss}`
+}
+
+/** Apply the composed stylesheet through the browser fallback style element. */
+function applyFallbackCss(state: DesktopAppearanceState): void {
+  if (typeof document === 'undefined') return
+  let element = document.getElementById(STYLE_ID)
+  if (element === null) {
+    element = document.createElement('style')
+    element.id = STYLE_ID
+    document.head.append(element)
+  }
+  element.textContent = appearanceCss(state)
+}
+
+/** Read the browser fallback state (native carriers own the desktop source of truth). */
+function readFallback(): DesktopAppearanceState {
+  if (typeof localStorage === 'undefined') return DEFAULT_STATE
+  try {
+    const raw = localStorage.getItem(STORAGE_KEY)
+    if (raw === null) return DEFAULT_STATE
+    const parsed = JSON.parse(raw) as Partial<DesktopAppearanceState>
+    return { ...DEFAULT_STATE, ...parsed }
+  } catch {
+    return DEFAULT_STATE
+  }
+}
+
+/** Persist the browser fallback state. */
+function writeFallback(state: DesktopAppearanceState): void {
+  if (typeof localStorage === 'undefined') return
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(state))
+}
+
+/**
+ * One appearance preferences owner: the native shell bridge when present,
+ * localStorage plus an injected style element otherwise. Every write applies
+ * the composed stylesheet immediately and persists through the owning store.
+ */
+export class AppearanceSource {
+  /** Framework-observed appearance state for the Appearance section rows. */
+  readonly store = createSnapshotStore<DesktopAppearanceView>({ ...DEFAULT_STATE, available: false })
+  private live = true
+  private received = false
+  private readonly unsubscribe: (() => void) | undefined
+
+  /** @param bridge - Optional isolated Desktop API, absent in ordinary browsers. */
+  constructor(private readonly bridge: DesktopAppearanceBridge | undefined) {
+    if (bridge !== undefined) {
+      this.unsubscribe = bridge.subscribe((state) => {
+        if (!this.live) return
+        this.received = true
+        this.store.set({ ...state, available: true })
+      })
+      void bridge.status().then((state) => {
+        if (this.live && !this.received) this.store.set({ ...state, available: true })
+      }, () => {
+        if (this.live && !this.received) this.store.set({ ...readFallback(), available: false })
+      })
+    } else {
+      this.unsubscribe = undefined
+      const fallback = readFallback()
+      this.store.set({ ...fallback, available: false })
+      applyFallbackCss(fallback)
+    }
+  }
+
+  /** Change the corner-radius scale and apply it. @param scale - 0..2 multiplier. */
+  setCornerRadiusScale(scale: number): void {
+    const value = Math.min(2, Math.max(0, scale))
+    const state = { ...this.store.getSnapshot(), cornerRadiusScale: value }
+    this.store.set(state)
+    if (this.bridge === undefined) {
+      writeFallback(state)
+      applyFallbackCss(state)
+      return
+    }
+    void this.bridge.setCornerRadiusScale(value).catch(() => { /* native reapplies on next status */ })
+  }
+
+  /** Replace the user stylesheet and apply it. @param css - raw CSS text. */
+  setCustomCss(css: string): void {
+    const state = { ...this.store.getSnapshot(), customCss: css }
+    this.store.set(state)
+    if (this.bridge === undefined) {
+      writeFallback(state)
+      applyFallbackCss(state)
+      return
+    }
+    void this.bridge.setCustomCss(css).catch(() => { /* native reapplies on next status */ })
+  }
+
+  /** Show or hide the status-area app indicator. @param enabled - target visibility. */
+  setAppindicatorEnabled(enabled: boolean): void {
+    const state = { ...this.store.getSnapshot(), appindicatorEnabled: enabled }
+    this.store.set(state)
+    if (this.bridge === undefined) {
+      writeFallback(state)
+      return
+    }
+    void this.bridge.setAppindicatorEnabled(enabled).catch(() => { /* native reapplies on next status */ })
+  }
+
+  /** Pick the app indicator artwork. @param style - symbolic or coloured. */
+  setIconStyle(style: 'symbolic' | 'coloured'): void {
+    const state = { ...this.store.getSnapshot(), iconStyle: style }
+    this.store.set(state)
+    if (this.bridge === undefined) {
+      writeFallback(state)
+      return
+    }
+    void this.bridge.setIconStyle(style).catch(() => { /* native reapplies on next status */ })
+  }
+
+  /** Detach the carrier and ignore any pending status or action completion. */
+  dispose(): void { this.live = false; this.unsubscribe?.() }
+}
