#!/usr/bin/env bash
# DeepSeek Harness for Linux launcher.
# Works from a source checkout, from a packaged install (/usr/lib/dsh-linux,
# /app/lib/dsh-linux), and through the /usr/bin symlink.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$ROOT"

# Desktop-launched apps get a minimal PATH that misses shell additions (nvm,
# volta, ~/.local/bin, …). Restore the common ones so python3 and the dsh
# tooling resolve; the app itself re-discovers node/pnpm/git with the same
# search list when even this PATH is insufficient.
for extra in \
  "$HOME"/.nvm/versions/node/*/bin \
  "$HOME/.nvm/current/bin" \
  "$HOME/.volta/bin" \
  "$HOME/.asdf/shims" \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.local/share/fnm" \
  "$HOME/.local/bin" \
  "$HOME/bin" \
  /opt/node/bin \
  /usr/local/bin \
  /app/bin; do
  [ -d "$extra" ] && PATH="$PATH:$extra"
done
export PATH

# Bundled tools (flatpak: node + git live in /app; pnpm rides along everywhere).
[ -x /app/bin/node ] && export DSH_LINUX_NODE=/app/bin/node
[ -x /app/bin/git ] && { export DSH_LINUX_GIT=/app/bin/git; [ -d /app/lib/git-core ] && export GIT_EXEC_PATH=/app/lib/git-core; }
[ -f "$ROOT/vendor/pnpm/bin/pnpm.mjs" ] && export DSH_LINUX_PNPM="$ROOT/vendor/pnpm/bin/pnpm.mjs"
[ -d "$ROOT/share/dsh-linux/dsh" ] && export DSH_LINUX_SNAPSHOT="$ROOT/share/dsh-linux/dsh"

PYTHON="${DSH_LINUX_PYTHON:-$(command -v python3 2>/dev/null || true)}"
if [ -z "$PYTHON" ] && [ -x /usr/bin/python3 ]; then PYTHON=/usr/bin/python3; fi
if [ -z "$PYTHON" ] && [ -x /app/bin/python3 ]; then PYTHON=/app/bin/python3; fi
if [ -z "$PYTHON" ]; then
  echo "dsh-linux: python3 was not found; install python3 with PyGObject (python3-gi)." >&2
  exit 1
fi

export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m dsh_linux "$@"
